# ClearCut local configuration
#
# Copy this file to `.env` and edit it. `.env` is git-ignored, so your keys and
# project names stay on your machine.
#
#   cp .env.example .env
#
# Out of the box ClearCut runs with NO paid services. You can import scripts,
# browse projects and use the workspace. What you cannot do is produce findings,
# because finding things requires calling Google Gemini and Parallel, which cost
# money. Until you turn those on, ClearCut says so plainly instead of inventing
# results.


# =============================================================================
# Everything below here is optional. Skip it entirely for a free local run.
# =============================================================================


# -----------------------------------------------------------------------------
# Turning on live detection and research
# -----------------------------------------------------------------------------
# There are two separate switches, and BOTH must be set. This is deliberate.
#
#   1. CAN we reach the providers?   -> project + credentials (this section)
#   2. MAY we spend money?           -> the policy section further down
#
# Setting only the first gives you "not enabled on this deployment".
# Setting only the second gives you "provider is not enabled".
# You need both. Read the whole file before running anything.


# --- Google Cloud, for Gemini (detection, research planning, judging) --------

# Your Google Cloud project id. Find it with:  gcloud projects list
GOOGLE_CLOUD_PROJECT=

# Google bills API quota to a project. Personal (non-service-account) logins
# don't carry one, so Vertex rejects them. Set this to the SAME project id above.
#
# You may see advice to run:
#     gcloud auth application-default set-quota-project YOUR-PROJECT
# That works, but it is machine-wide and will affect every other Google Cloud
# app on this computer. Setting the variable here affects ClearCut only, which
# is why we prefer it.
GOOGLE_CLOUD_QUOTA_PROJECT=

# Region for the models. Leave as-is unless you know you need another.
CLEARCUT_VERTEX_LOCATION=global

# Credentials file, only needed when running in Docker.
#
# Running WITHOUT Docker: leave this blank. Just run
#     gcloud auth application-default login
# and ClearCut will find the credentials automatically.
#
# Running WITH Docker: the container has no home directory, so it cannot find
# the usual credentials file. Uncomment the `volumes:` block under the `app`
# service in docker-compose.yml, then set this to the path it mounts:
#     GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/gcp/adc.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- Parallel, for evidence research ----------------------------------------

# Your Parallel API key. Detection can run without this; gathering cited
# evidence cannot.
PARALLEL_API_KEY=


# -----------------------------------------------------------------------------
# Policy: authorising spend
# -----------------------------------------------------------------------------
# WARNING: the two settings below are what actually start costing money.
# Nothing above spends anything on its own.

# Which paid providers this deployment may use. Comma-separated.
# Empty means none, which is the default.
#
#   gemini            -> detection, research planning and judging
#   gemini,parallel    -> the above plus cited evidence research
#
# Suggestion for a first run: start with `gemini` alone. If something is
# misconfigured you are debugging one provider instead of two.
CLEARCUT_PAID_PROVIDERS_ENABLED=

# Set to true to confirm you understand that enabling the providers above will
# incur charges on your Google Cloud and Parallel accounts. ClearCut refuses to
# make a paid call while this is false, even if everything else is configured.
#
# This is a deliberate human decision. Do not set it because a tool told you to.
CLEARCUT_PAID_PROVIDER_COST_ACKNOWLEDGED=false

# Maximum simultaneous calls per provider. Must be at least 1.
# Keep these at 1 for your first runs: it makes cost predictable and stops a
# runaway job from multiplying charges.
CLEARCUT_GEMINI_CONCURRENCY_LIMIT=1
CLEARCUT_PARALLEL_CONCURRENCY_LIMIT=1


# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------
# Pinned on purpose. Reports record the exact judge model used, so a report you
# generated last month keeps telling the truth about how it was produced.
# Only change these if you know the replacement is available in your project;
# an unavailable name fails on the first real call, not at startup.
CLEARCUT_GEMINI_DETECTION_MODEL=gemini-3.8-flash
CLEARCUT_GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
CLEARCUT_GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview


# -----------------------------------------------------------------------------
# Local run behaviour
# -----------------------------------------------------------------------------

# Load demo fixtures on startup.
CLEARCUT_SEED_DEMO=false

# Background job execution. `local` runs jobs in the web process and requires
# exactly one worker. `disabled` accepts jobs but never runs them.
CLEARCUT_JOB_DISPATCH_MODE=local
CLEARCUT_API_WORKERS=1
