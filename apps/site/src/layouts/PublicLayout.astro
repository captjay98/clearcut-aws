---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "ClearCut - Screenplay pre-clearance evidence desk for independent cinema" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ClearCut</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ClearCut`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased">
    <header class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-2 font-bold text-xl text-blue-600 dark:text-blue-400">
          <span>ClearCut</span>
        </a>
        <nav class="flex items-center space-x-6 text-sm font-medium">
          <a href="/features" class="hover:text-blue-600 dark:hover:text-blue-400">Features</a>
          <a href="/docs" class="hover:text-blue-600 dark:hover:text-blue-400">Docs</a>
          <a href="http://localhost:3000/auth/sign-in" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md">
            Open Workspace
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800 mt-20 py-10 bg-white dark:bg-slate-900 text-sm text-slate-500 text-center">
      <p>&copy; 2026 ClearCut. Built for Agentic Cinema (Parallel Track). Open source under MIT License.</p>
    </footer>
  </body>
</html>
