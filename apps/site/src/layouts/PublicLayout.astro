---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ClearCut - Screenplay pre-clearance evidence desk for independent cinema",
} = Astro.props;

const REPO_URL = "https://github.com/captjay98/clearcut";

// The prototype varies its footer nav per surface so the current page is never a
// self-link. Same behaviour here, derived from the route rather than hardcoded.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const footerLinks = [
  { href: "/", label: "Home" },
  { href: "/features", label: "Features" },
  { href: "/docs", label: "Docs" },
].filter((link) => link.href !== path);
---

<!doctype html>
<html lang="en" data-theme="script">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f3ea" />
    <title>{title} | ClearCut</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ClearCut`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("clearcut-theme");
          const migrated =
            {
              light: "script",
              dark: "night",
              "day-shoot": "script",
              "night-shoot": "night",
              "high-contrast": "night",
              studio: "script",
              ledger: "script",
            }[saved] || saved;
          const theme = ["script", "night"].includes(migrated) ? migrated : "script";
          document.documentElement.dataset.theme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "night" ? "#14161b" : "#f6f3ea");
        } catch (_) {
          /* storage unavailable */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-label="ClearCut home">
          <span class="slate-mark" aria-hidden="true"><span>CC</span></span>
          <span>ClearCut</span>
        </a>
        <nav class="public-nav" aria-label="Explore ClearCut">
          <a href="/features" aria-current={path === "/features" ? "page" : undefined}>Features</a>
          <a href="/docs" aria-current={path === "/docs" ? "page" : undefined}>Docs</a>
          <a href={REPO_URL} target="_blank" rel="noopener">Source</a>
        </nav>
        <div class="header-spacer"></div>
        <div class="header-actions public-header-actions">
          <button
            class="icon-button is-bare"
            type="button"
            data-action="open-appearance"
            aria-label="Toggle workspace appearance"
          >
            <span aria-hidden="true">◐</span>
          </button>
          <a class="button button-quiet" href="/app/auth/sign-in">Sign in</a>
          <a class="button button-primary" href="/app/auth/sign-in">Open demo</a>
        </div>
      </div>
      <span class="revision-bar" aria-hidden="true"></span>
    </header>

    <!-- The prototype scopes --lp-max / --lp-gutter and the page background on .lp
         and keeps the footer inside it. The wrapper lives here rather than in each
         page so the footer resolves the same custom properties it does in the mock. -->
    <div class="lp">
      <main id="main-content">
        <slot />
      </main>

      <footer class="lp-footer">
        <div class="lp-footer-brand">
          <strong>ClearCut</strong>
          <span>Open-source, self-hosted screenplay clearance evidence workspace.</span>
        </div>
        <nav class="lp-footer-nav" aria-label="Footer navigation">
          {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <p class="lp-footer-legal">
          &copy; 2026 ClearCut &middot; MIT License &middot; Nothing here is legal advice; clearance
          decisions belong to qualified humans.
        </p>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-action="open-appearance"]');
        if (!toggle) return;
        toggle.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "night" ? "script" : "night";
          document.documentElement.dataset.theme = next;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", next === "night" ? "#14161b" : "#f6f3ea");
          try {
            localStorage.setItem("clearcut-theme", next);
          } catch (_) {
            /* storage unavailable */
          }
        });
      })();
    </script>
  </body>
</html>
