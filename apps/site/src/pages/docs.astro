---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="ClearCut Documentation & Architecture">
  <div class="page narrow">
    <header class="page-head">
      <span class="eyebrow">Architecture &amp; governance</span>
      <h1 class="lp-h2">How ClearCut is built.</h1>
      <p class="page-lede">
        ClearCut uses Google ADK / Gemini for candidate detection and Parallel Search/Extract for
        source-backed evidence gathering.
      </p>
    </header>
    <div class="stack">
      <article class="card">
        <h2 class="lp-note-title">Mandatory Parallel Search</h2>
        <p>The web research path always begins with real Parallel Search.</p>
      </article>
      <article class="card">
        <h2 class="lp-note-title">Provenance mandatory</h2>
        <p>Every claim cites an immutable snapshot with a SHA-256 hash.</p>
      </article>
      <article class="card">
        <h2 class="lp-note-title">Human governance</h2>
        <p>AI models never make binding legal conclusions or clearance decisions.</p>
      </article>
    </div>
  </div>
</PublicLayout>
