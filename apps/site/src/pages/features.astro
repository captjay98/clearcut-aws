---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="ClearCut Features & Ten Categories">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6">Ten Protected Clearance Categories</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">1. Real Persons (Living)</h2>
        <p class="text-sm text-slate-500">Defamation, privacy, and living public figure rights.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">2. Real Persons (Deceased)</h2>
        <p class="text-sm text-slate-500">Right of publicity and post-mortem estate protections.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">3. Corporate Entities</h2>
        <p class="text-sm text-slate-500">Company names, business registrations, and studio trademarks.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">4. Products & Trademarks</h2>
        <p class="text-sm text-slate-500">Commercial brands, logos, product placements, and trade dress.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">5. Copyrighted Works</h2>
        <p class="text-sm text-slate-500">Books, movies, TV shows, paintings, and artistic works.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">6. Music & Lyrics</h2>
        <p class="text-sm text-slate-500">Song titles, lyrics, compositions, and master recording cues.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">7. Locations & Landmarks</h2>
        <p class="text-sm text-slate-500">Protected buildings, private estates, and architectural rights.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">8. Vehicles & Insignia</h2>
        <p class="text-sm text-slate-500">Police badges, military emblems, vehicle models, and logos.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">9. Sensitive Historical Events</h2>
        <p class="text-sm text-slate-500">Recent tragedies, active crimes, and contested historical facts.</p>
      </div>
      <div class="p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
        <h2 class="font-semibold text-lg mb-2">10. Contact Information</h2>
        <p class="text-sm text-slate-500">Phone numbers, email addresses, websites, and physical addresses.</p>
      </div>
    </div>
  </div>
</PublicLayout>
