---
import PublicLayout from '../layouts/PublicLayout.astro';

const categories = [
  ['1. Real Persons (Living)', 'Defamation, privacy, and living public figure rights.'],
  ['2. Real Persons (Deceased)', 'Right of publicity and post-mortem estate protections.'],
  ['3. Corporate Entities', 'Company names, business registrations, and studio trademarks.'],
  ['4. Products & Trademarks', 'Commercial brands, logos, product placements, and trade dress.'],
  ['5. Copyrighted Works', 'Books, movies, TV shows, paintings, and artistic works.'],
  ['6. Music & Lyrics', 'Song titles, lyrics, compositions, and master recording cues.'],
  ['7. Locations & Landmarks', 'Protected buildings, private estates, and architectural rights.'],
  ['8. Vehicles & Insignia', 'Police badges, military emblems, vehicle models, and logos.'],
  ['9. Sensitive Historical Events', 'Recent tragedies, active crimes, and contested historical facts.'],
  ['10. Contact Information', 'Phone numbers, email addresses, websites, and physical addresses.'],
];
---

<PublicLayout title="ClearCut Features & Ten Categories">
  <div class="page narrow">
    <header class="page-head">
      <span class="eyebrow">Detection coverage</span>
      <h1 class="lp-h2">Ten protected clearance categories.</h1>
      <p class="page-lede">
        ClearCut reads scene by scene across ten clearance categories, connecting each flagged
        passage to retained source evidence.
      </p>
    </header>
    <div class="lp-notes">
      {
        categories.map(([name, desc]) => (
          <article class="card">
            <h2 class="lp-note-title">{name}</h2>
            <p>{desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</PublicLayout>
