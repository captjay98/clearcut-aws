#!/usr/bin/env bash
# ClearCut local control tool. Cloud deployment remains fail-closed until the
# external release gates in docs/submission/manifest.yaml are satisfied.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$DIR"

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
  echo -e "${CYAN}${BOLD}ClearCut — Screenplay Pre-Clearance Evidence Workspace${NC}"
  echo -e "Usage: ${BOLD}./clearcut <command>${NC}\n"
  echo -e "${BOLD}Commands:${NC}"
  echo -e "  ${GREEN}start${NC} / ${GREEN}up${NC}      Launch the local Docker workspace"
  echo -e "  ${YELLOW}stop${NC} / ${YELLOW}down${NC}     Stop local ClearCut containers"
  echo -e "  ${RED}deploy${NC}           Report the deployment NO-GO gate; does not deploy"
  echo -e "  ${CYAN}logs${NC}             View local container logs"
  echo -e "  ${CYAN}config${NC} / ${CYAN}keys${NC}      Report local provider configuration status"
  echo -e "  ${CYAN}cost${NC}             Show the cloud-cost safety boundary"
  echo -e "  ${CYAN}smoke${NC}            Run the local/explicit-URL smoke verification"
  echo -e "  ${CYAN}status${NC}           Show local containers and submission readiness"
  echo -e "  ${CYAN}help${NC}             Show this help screen\n"
}

CMD="${1:-start}"

case "$CMD" in
  start|up)
    exec "$DIR/scripts/start_local.sh" "${@:2}"
    ;;
  stop|down)
    echo -e "${YELLOW}Stopping ClearCut local containers...${NC}"
    docker compose down
    echo -e "${GREEN}ClearCut stopped.${NC}"
    ;;
  deploy|gcp)
    echo -e "${RED}${BOLD}Deployment is blocked while submission readiness is NO-GO.${NC}" >&2
    echo "Review docs/submission/manifest.yaml and infra/gcp/README.md." >&2
    echo "This command does not authenticate, provision resources, deploy, or incur cloud charges." >&2
    exit 1
    ;;
  logs)
    exec docker compose logs -f
    ;;
  cost|pricing)
    echo -e "${YELLOW}${BOLD}No production cost estimate is verified.${NC}"
    echo "Cloud usage can incur charges for builds, images, compute, databases, storage, networking, providers, and logs."
    echo "Review an authorized provider estimate, budget, and alert policy before any deployment."
    ;;
  config|keys|env)
    if [ -n "${PARALLEL_API_KEY:-}" ]; then
      echo "Parallel API credential: present in the current process (value not displayed)."
    else
      echo "Parallel API credential: not configured. Research remains unresolved; no fallback evidence is created."
    fi
    if [ -n "${GCP_PROJECT:-}" ]; then
      echo "GCP project variable: present in the current process (not verified or contacted)."
    else
      echo "GCP project variable: not configured."
    fi
    echo "Configure secrets through an approved local or deployment secret mechanism; this command does not transmit them."
    ;;
  smoke|test)
    TARGET_URL="${2:-http://localhost:8000}"
    exec python3 "$DIR/scripts/deployment_smoke.py" --url "$TARGET_URL"
    ;;
  status)
    echo -e "${BOLD}=== Local Docker Status ===${NC}"
    if command -v docker >/dev/null 2>&1; then
      docker compose ps || true
    else
      echo "Docker is not installed or not in PATH."
    fi
    echo -e "\n${BOLD}=== Submission Readiness ===${NC}"
    echo "NO-GO — see docs/submission/manifest.yaml for explicit external blockers."
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo -e "${YELLOW}Unknown command: $CMD${NC}\n" >&2
    show_help >&2
    exit 1
    ;;
esac
