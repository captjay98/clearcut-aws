#!/usr/bin/env bash
# ==============================================================================
# ClearCut — Unified CLI Control Tool
# ==============================================================================
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$DIR"

# ANSI Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
  echo -e "${CYAN}${BOLD}ClearCut — Screenplay Pre-Clearance & Evidence Workspace${NC}"
  echo -e "Usage: ${BOLD}./clearcut <command>${NC}\n"
  echo -e "${BOLD}Commands:${NC}"
  echo -e "  ${GREEN}start${NC} / ${GREEN}up${NC}      Launch the local ClearCut studio with PostgreSQL 17 (Docker)"
  echo -e "  ${YELLOW}stop${NC} / ${YELLOW}down${NC}     Stop all local ClearCut containers"
  echo -e "  ${BLUE}deploy${NC}           Deploy ClearCut to Google Cloud Run (interactive wizard)"
  echo -e "  ${CYAN}logs${NC}             View real-time logs from local containers"
  echo -e "  ${CYAN}smoke${NC}            Run automated 7-step smoke verification tests"
  echo -e "  ${CYAN}status${NC}           Check status of local and cloud deployments"
  echo -e "  ${CYAN}help${NC}             Show this help screen\n"
}

CMD="${1:-start}"

case "$CMD" in
  start|up)
    exec "$DIR/scripts/start_local.sh" "${@:2}"
    ;;
  stop|down)
    echo -e "${YELLOW}Stopping ClearCut local containers...${NC}"
    docker compose down
    echo -e "${GREEN}✓ ClearCut stopped.${NC}"
    ;;
  deploy|gcp)
    exec "$DIR/scripts/deploy_gcp.sh" "${@:2}"
    ;;
  logs)
    docker compose logs -f
    ;;
  smoke|test)
    if [ -n "${2:-}" ]; then
      TARGET_URL="$2"
    else
      TARGET_URL="http://localhost:8000"
    fi
    exec python3 "$DIR/scripts/deployment_smoke.py" --url "$TARGET_URL"
    ;;
  status)
    echo -e "${BOLD}=== Local Docker Status ===${NC}"
    if command -v docker >/dev/null 2>&1; then
      docker compose ps || echo "No local containers running."
    else
      echo "Docker is not installed or not in PATH."
    fi
    echo -e "\n${BOLD}=== Live GCP Service Status ===${NC}"
    if command -v gcloud >/dev/null 2>&1; then
      CURRENT_PROJ="$(gcloud config get-value project 2>/dev/null || echo "")"
      if [ -n "$CURRENT_PROJ" ]; then
        echo "Active GCP Project: $CURRENT_PROJ"
        gcloud run services describe clearcut --region us-central1 --project "$CURRENT_PROJ" --format="table(metadata.name,status.url,status.conditions[0].status)" 2>/dev/null || echo "Service not deployed on $CURRENT_PROJ"
      fi
    fi
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo -e "${YELLOW}Unknown command: $CMD${NC}\n"
    show_help
    exit 1
    ;;
esac
